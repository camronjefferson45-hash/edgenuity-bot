{
  "manifest_version": 3,
  "name": "Edgenuity Bot",
  "version": "2.0",
  "description": "Automate Edgenuity lessons",
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://student.edgenuity.com/*",
    "*://r20.core.learn.edgenuity.com/*",
    "*://*.edgenuity.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://student.edgenuity.com/*",
        "*://r20.core.learn.edgenuity.com/*",
        "*://*.edgenuity.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
